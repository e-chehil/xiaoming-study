+std::pair<std::wstring, std::wstring> Layout::CommentParts(int index) const {
+  const auto& value = comments.at(index).str;
+  if (_status.schema_id != L"xiaoming" ||
+      (_style.layout_type != UIStyle::LAYOUT_VERTICAL && _style.layout_type != UIStyle::LAYOUT_HORIZONTAL))
+    return {L"", value};
+  if (value.empty()) return {L"", value};
+  const auto separator = value.find(L"  ");
+  const auto first = value.substr(0, separator);
+  const auto tail = separator == std::wstring::npos ? L"" : value.substr(separator + 2);
+  if (first == L"␣") return {L"_", tail};
+  if (first.size() > 1 && first[0] == L'＋' && first.find_first_not_of(L"abcdefghijklmnopqrstuvwxyz_", 1) == std::wstring::npos)
+    return {first.substr(1), tail};
+  return {L"", value};
+}
+
+int Layout::PlaceSubscript(int index, PDWR pDWR, int x, int y) {
+  const auto hint = CommentParts(index).first;
+  subscript_rects[index].SetRectEmpty();
+  if (hint.empty()) return 0;
+  CSize size;
+  GetTextSizeDW(hint, hint.size(), pDWR->pSubscriptTextFormat, pDWR, &size);
+  const int gap = max(1, static_cast<int>(3 * pDWR->dpiScaleLayout));
+  subscript_rects[index].SetRect(x + gap, y, x + gap + size.cx, y + size.cy);
+  return gap + size.cx;
+}
+
+void Layout::AddFooter(CDCHandle dc, PDWR pDWR, int width, int& height) {
+  footer_rect.SetRectEmpty();
+  if (_status.schema_id != L"xiaoming" || !candidates_count || !pDWR->footer_enabled ||
+      _status.schema_name.empty()) return;
+  CSize size;
+  GetTextSizeDW(_status.schema_name, _status.schema_name.size(), pDWR->pFooterTextFormat, pDWR, &size);
+  const int left = offsetX + max(0, (width - size.cx) / 2);
+  footer_rect.SetRect(left, height + offsetY, left + size.cx, height + offsetY + size.cy);
+  height += size.cy + real_margin_y;
 }
 
