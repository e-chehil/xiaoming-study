{
  "name": "xiaoming-study",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "start": "node scripts/serve.mjs --open",
    "test": "node --test tests/*.test.mjs",
    "test:downloads": "node tests/downloads-browser.mjs",
    "data:exports": "node scripts/export_study.mjs",
    "data:cedict": "python scripts/prepare_cedict.py && node scripts/cedict_coverage.mjs",
    "data:cedict:update": "python scripts/prepare_cedict.py --update && node scripts/cedict_coverage.mjs",
    "data:build": "python scripts/build_curricula.py",
    "data:validate": "node scripts/validate_curricula.mjs"
  },
  "dependencies": {
    "ts-fsrs": "5.4.2"
  },
  "devDependencies": {
    "playwright-core": "1.56.1",
    "ajv": "8.20.0"
  }
}
